   "source": [
    "import matplotlib.pyplot as plt\n",
    "\n",
    "plt.figure(figsize=(14, 10))\n",
    "\n",
    "# Top 6 cohortes\n",
    "top6 = er_cohorte.groupby('COHORTE')['EAD_sum'].sum().nlargest(6).index\n",
    "\n",
    "for coh in top6:\n",
    "    data = er_cohorte[er_cohorte['COHORTE'] == coh].sort_values('AGE_MOIS')\n",
    "    plt.plot(data['AGE_MOIS']/12, data['ER_obs'], \n",
    "             'o-', label=f'Obs.{coh}', linewidth=3, markersize=8)\n",
    "    plt.axhline(y=data['ER_moyen_age'].iloc[0], color='red', \n",
    "                linestyle='--', linewidth=2, alpha=0.8, \n",
    "                label=f'Moyen âge {coh}')\n",
    "\n",
    "plt.xlabel('Âge du prêt (années)')\n",
    "plt.ylabel('ER observé / ER moyen (%)')\n",
    "plt.title('ER Observé vs ER Moyen par classe d\\'âge')\n",
    "plt.legend(bbox_to_anchor=(1.02, 1))\n",
    "plt.grid(True, alpha=0.3)\n",
    "plt.tight_layout()\n",
    "plt.savefig('ER_moyen_graph.png', dpi=300)\n",
    "plt.show()\n"
   ]
  },

   "source": [
    "baseline_er = (\n",
    "    df.groupby(\"AGE_PRET_BIN\")\n",
    "    .agg(\n",
    "        taux_ER=(\"FLAG_ER\", \"mean\"),\n",
    "        ER_moyen=(\"ER_obs\", \"mean\"),\n",
    "        ER_cond=(\"ER_obs\", lambda x: x[x > 0].mean()),\n",
    "        n_obs=(\"ER_obs\", \"size\")\n",
    "    )\n",
    "    .reset_index()\n",
    ")\n",
    "\n",
    "baseline_er\n"
   ]
  },

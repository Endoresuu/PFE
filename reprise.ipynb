    "def predire_er(age_mois, b_mat, b_resmat, csp, classact, cohorte=\"2026\"):\n",
    "    \"\"\"Prédire ER pour NOUVEAU prêt\"\"\"\n",
    "    df_test = pd.DataFrame({\n",
    "        'AGE_MOIS': [age_mois], 'B_MAT': [b_mat], 'B_RESMAT': [b_resmat],\n",
    "        'CSP': [csp], 'CLASSACT': [classact], 'COHORTE_STR': [cohorte]\n",
    "    })\n",
    "    X_test = pd.get_dummies(df_test[['AGE_MOIS', 'B_MAT', 'B_RESMAT', 'CSP', 'CLASSACT', 'COHORTE_STR']], drop_first=True)\n",
    "    X_test = X_test.reindex(columns=X.columns, fill_value=0)\n",
    "    return rf.predict(X_test)[0]\n",
    "\n",
    "print(\"🧪 PROJECTIONS FUTURES (exemples) :\")\n",
    "print(f\"• Prêt jeune court  : {predire_er(6, 120, 114, 70, 1):.1%}\")\n",
    "print(f\"• Prêt intermédiaire: {predire_er(24, 240, 216, 70, 1):.1%}\")\n",
    "print(f\"• Prêt mature long  : {predire_er(60, 360, 300, 70, 1):.1%}\")\n",
    "print(f\"• Prêt 2026 récent  : {predire_er(3, 180, 177, 70, 1, '2026'):.1%}\")\n"
   ]

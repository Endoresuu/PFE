   "source": [
    "# ER moyen par âge (pondéré EAD) - VERSION SIMPLE\n",
    "er_cohorte['AGE_AN'] = er_cohorte['AGE_MOIS'] / 12\n",
    "\n",
    "# 1. ER moyen PAR CLASSE D'ÂGE (toutes cohortes)\n",
    "er_moyen_age = er_cohorte.groupby('AGE_PRET_BIN').apply(\n",
    "    lambda x: np.average(x['ER_obs'], weights=x['EAD_sum'])\n",
    ").round(4)\n",
    "\n",
    "# 2. ER moyen PAR COHORTE (tous âges)\n",
    "er_moyen_coh = er_cohorte.groupby('COHORTE').apply(\n",
    "    lambda x: np.average(x['ER_obs'], weights=x['EAD_sum'])\n",
    ").round(4)\n",
    "\n",
    "# Assignation à chaque ligne\n",
    "er_cohorte['ER_moyen_age'] = er_cohorte['AGE_PRET_BIN'].map(er_moyen_age)\n",
    "er_cohorte['ER_moyen_coh'] = er_cohorte['COHORTE'].map(er_moyen_coh)\n",
    "\n",
    "print(\"🏆 ER MOYEN PAR ÂGE :\")\n",
    "print(er_moyen_age)\n",
    "print(\"\\n🏆 ER MOYEN PAR COHORTE (top 10) :\")\n",
    "print(er_moyen_coh.nlargest(10))\n",
    "\n",
    "print(f\"\\n✅ ER moyen global : {er_cohorte['ER_moyen_age'].mean():.1%}\")\n"
   ]
  },

   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "from dateutil.relativedelta import relativedelta\n",
    "\n",
    "\n",
    "\n",
    "# Conversion DARRET (format 201901 → datetime)\n",
    "df['DARRET'] = pd.to_datetime(df['DARRET'], format='%Y%m')\n",
    "\n",
    "# Âge du prêt en mois\n",
    "df['AGE_MOIS'] = df['B_MAT'] - df['B_RESMAT']\n",
    "\n",
    "# Date d'origine ligne par ligne avec apply\n",
    "def calcul_date_orig(row):\n",
    "    return row['DARRET'] - relativedelta(months=int(row['AGE_MOIS']))\n",
    "\n",
    "df['DATE_ORIG_APPROX'] = df.apply(calcul_date_orig, axis=1)\n",
    "\n",
    "# Cohorte par année d'origine\n",
    "df['COHORTE'] = df['DATE_ORIG_APPROX'].dt.to_period('Y')\n",
    "df['COHORTE_Q'] = df['DATE_ORIG_APPROX'].dt.to_period('Q')\n",
    "\n",
    "# Classes d'âge (comme ton notebook)\n",
    "df['AGE_PRET_BIN'] = pd.cut(df['AGE_MOIS'], \n",
    "                           bins=[0,12,36,60,120,np.inf], \n",
    "                           labels=['0-12','12-36','36-60','60-120','120+'])\n",
    "\n",
    "# AJOUT : juste 2 lignes pour corriger ER négatifs\n",
    "df['RA'] = df['RA'].clip(lower=0)  # RA négatifs → 0\n",
    "print(f\" df complet : {len(df)} lignes | RA nettoyés : {(df['RA'] < 0).sum()}\")"
   ]
  },

   "source": [
    "# CELLULE 2 : Table ER par cohorte × âge (CORRIGÉE)\n",
    "group_cols = ['COHORTE', 'AGE_PRET_BIN', 'AGE_MOIS', 'CSP', 'CLASSACT']\n",
    "\n",
    "er_cohorte = (df\n",
    "    .groupby(group_cols)\n",
    "    .agg(\n",
    "        RA_sum=('RA', 'sum'),\n",
    "        EAD_sum=('EAD', 'sum'),\n",
    "        n_obs=('EAD', 'count')\n",
    "    )\n",
    "    .reset_index()  # ← IMPORTANT : remet les colonnes groupby\n",
    ")\n",
    "\n",
    "er_cohorte['ER_obs'] = er_cohorte['RA_sum'] / er_cohorte['EAD_sum']\n",
    "er_cohorte = er_cohorte[er_cohorte['EAD_sum'] > 1000]  # Filtre minimum\n",
    "\n",
    "print(f\"✅ Table cohortes : {len(er_cohorte)} bins\")\n",
    "print(er_cohorte[['COHORTE', 'AGE_PRET_BIN', 'ER_obs', 'EAD_sum']].head(10))\n",
    "print(f\"\\nER stats : {er_cohorte['ER_obs'].describe()}\")\n"
   ]

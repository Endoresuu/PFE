    "        'PTI':      0.044, # Q25\n",
    "        'Tx':       2.084, # Q25\n",
    "        'RATIO_AGE': 0.242 # Q25\n",
    "    },\n",
    "    'Moyen / standard': {\n",
    "        'AGE_CLI': 52.0,   # médiane\n",
    "        'PTI':      0.081, # médiane\n",

    "log_nettoyage.append(('RA >= 0', n3))\n",
    "print(f'[4] Après filtre RA >= 0 : {n3:,} (-{n2-n3:,})')\n",
    "\n",
    "# ── Tx : taux d'intérêt\n",
    "# Valeurs négatives : économiquement impossibles sur crédit conso\n",

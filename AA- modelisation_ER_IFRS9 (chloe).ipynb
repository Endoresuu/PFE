    "log_nettoyage.append(('produit == AMO', n2))\n",
    "print(f'[3] Après filtre produit=AMO : {n2:,} (-{n1-n2:,})')\n",
    "\n",
    "# ── RA : suppression des valeurs négatives (incohérentes économiquement)\n",
    "df = df[df['RA'] >= 0]\n",

    "# =========================\n",
    "# 3) COURBES ER(t) : observé (KM) vs prédit (Cox)\n",
    "#    IMPORTANT : moyenne des survies individuelles (plus correct que \"theta_mean\")\n",
    "# =========================\n",
    "from lifelines import KaplanMeierFitter\n",
    "\n",
    "def mean_predicted_survival(cph, df_aligned, duration_col=DURATION_COL, event_col=EVENT_COL, t_max=120):\n",
    "    X = df_aligned.drop(columns=[duration_col, event_col])\n",
    "    # predict_survival_function -> DataFrame index=time, columns=individuals\n",
    "    S = cph.predict_survival_function(X, times=np.arange(0, t_max+1))\n",
    "    return S.mean(axis=1)  # moyenne sur individus\n",
    "\n",
    "def plot_er_curves(cph, test_df_aligned, title, t_max=120):\n",
    "    kmf = KaplanMeierFitter()\n",
    "    kmf.fit(test_df_aligned[DURATION_COL], event_observed=test_df_aligned[EVENT_COL])\n",
    "\n",
    "    t = np.arange(0, t_max+1)\n",
    "    S_obs = kmf.survival_function_at_times(t)\n",
    "    ER_obs = 1 - S_obs\n",
    "\n",
    "    S_pred_mean = mean_predicted_survival(cph, test_df_aligned, t_max=t_max)\n",
    "    ER_pred = 1 - S_pred_mean\n",
    "\n",
    "    plt.figure(figsize=(9,5))\n",
    "    plt.plot(t, ER_obs.values, label=\"ER observé (KM)\")\n",
    "    plt.plot(t, ER_pred.values, label=\"ER prédit (Cox, moyenne des survies)\")\n",
    "    plt.xlabel(\"t (mois)\")\n",
    "    plt.ylabel(\"ER(t)\")\n",
    "    plt.title(title)\n",
    "    plt.grid(True, alpha=0.3)\n",
    "    plt.legend()\n",
    "    plt.show()\n",
    "\n",
    "plot_er_curves(cph_A, test_A, \"MODELE A (avec RATIO_AGE) : ER(t) observé vs prédit\", t_max=99)\n",
    "plot_er_curves(cph_B, test_B, \"MODELE B (sans RATIO_AGE) : ER(t) observé vs prédit\", t_max=99)"
   ]

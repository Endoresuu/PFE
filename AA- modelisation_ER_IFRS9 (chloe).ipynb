    "df['ERG_OBS'] = np.where(\n",
    "    (df['RA'] > 0) & (df['E_EAD'] > 0) & (df['CRD_THEORIQUE'] > 0),\n",
    "    df['RA'] / df['CRD_THEORIQUE'],\n",

    "# =========================\n",
    "# 4) METRIQUES SUR LA COURBE (MAE/RMSE entre ER_pred et ER_obs)\n",
    "# =========================\n",
    "from lifelines import KaplanMeierFitter\n",
    "from sklearn.metrics import mean_absolute_error, mean_squared_error\n",
    "\n",
    "def curve_metrics(cph, test_df_aligned, t_max=99):\n",
    "    kmf = KaplanMeierFitter()\n",
    "    kmf.fit(test_df_aligned[DURATION_COL], event_observed=test_df_aligned[EVENT_COL])\n",
    "\n",
    "    t = np.arange(0, t_max+1)\n",
    "    ER_obs = 1 - kmf.survival_function_at_times(t).values\n",
    "    ER_pred = 1 - mean_predicted_survival(cph, test_df_aligned, t_max=t_max).values\n",
    "\n",
    "    mae = mean_absolute_error(ER_obs, ER_pred)\n",
    "    rmse = np.sqrt(mean_squared_error(ER_obs, ER_pred))\n",
    "    return mae, rmse\n",
    "\n",
    "mae_A, rmse_A = curve_metrics(cph_A, test_A, t_max=99)\n",
    "mae_B, rmse_B = curve_metrics(cph_B, test_B, t_max=99)\n",
    "\n",
    "print(\"\\n=== METRIQUES COURBE (test) ===\")\n",
    "print(f\"A (avec RATIO_AGE)  | MAE={mae_A:.4f}  RMSE={rmse_A:.4f}\")\n",
    "print(f\"B (sans RATIO_AGE)  | MAE={mae_B:.4f}  RMSE={rmse_B:.4f}\")"
